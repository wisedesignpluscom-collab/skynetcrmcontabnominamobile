# ============================================================================
#  Variables de entorno para PRODUCCIÓN (Vercel + Supabase)
#  Estos valores se pegan en Vercel → Project → Settings → Environment Variables.
#  NO subir el archivo con valores reales: aquí solo van ejemplos.
# ============================================================================

# --- Base de datos (Supabase PostgreSQL) ------------------------------------
# DATABASE_URL = conexión POOLED (Transaction pooler, puerto 6543) para el runtime
# serverless. Copia la que Supabase muestra como "Transaction" y AÑADE ?pgbouncer=true.
DATABASE_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL = conexión DIRECTA (puerto 5432) para migraciones / prisma db push.
# Copia la que Supabase muestra como "Direct connection".
DIRECT_URL="postgresql://postgres:<PASSWORD>@db.<ref>.supabase.co:5432/postgres"

# --- Seguridad de sesión ----------------------------------------------------
# OBLIGATORIA, mínimo 32 caracteres. Genera una nueva con:  openssl rand -hex 32
AUTH_SECRET="<64-caracteres-hex-aleatorios>"

# En Vercel se sirve por HTTPS, así que la cookie va "secure". Déjala sin definir
# (por defecto es segura en producción) o ponla explícita:
COOKIE_SECURE="true"

# --- Cron del planificador (correos programados + automatizaciones) ---------
# Secreto que autoriza las llamadas a /api/cron. Genera uno con:  openssl rand -hex 32
# Se usa así:  https://<tu-app>.vercel.app/api/cron?key=<CRON_SECRET>
CRON_SECRET="<32-caracteres-hex-aleatorios>"
