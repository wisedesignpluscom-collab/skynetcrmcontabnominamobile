# Copia este archivo como .env y completa los valores reales.

# Base de datos:
#  - Desarrollo local (SQLite):  file:./dev.db
#  - Producción (PostgreSQL):    postgresql://usuario:clave@servidor:5432/nogui_crm
DATABASE_URL="file:./dev.db"

# Clave secreta para firmar las sesiones de login. OBLIGATORIA y mínimo 32
# caracteres — si falta o es corta, la app no arranca (evita sesiones falsificables).
# Generar una nueva con:  openssl rand -hex 32
AUTH_SECRET="cambiar-por-una-clave-secreta-de-64-caracteres"

# Clave secreta del portal de clientes (app/portal/*) — SEPARADA de AUTH_SECRET
# a propósito: un token de un sistema nunca debe servir para el otro. Mismos
# requisitos (≥32 caracteres, obligatoria).
# Generar una nueva con:  openssl rand -hex 32
PORTAL_AUTH_SECRET="cambiar-por-otra-clave-secreta-distinta-de-64-caracteres"

# (Opcional) Cookie de sesión sin "secure" para servir por HTTP en red local.
# En la nube/HTTPS déjalo sin definir o en "true".
# COOKIE_SECURE="false"

# (Opcional) Permitir que los webhooks de automatización llamen a IPs internas
# de la red local. Por defecto se bloquean (anti-SSRF). Actívalo solo si tienes
# un webhook interno legítimo.
# ALLOW_INTERNAL_WEBHOOKS="true"
